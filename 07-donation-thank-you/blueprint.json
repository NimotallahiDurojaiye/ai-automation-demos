{
  "name": "07 Donation thank-you and receipt",
  "flow": [
    {
      "id": 1,
      "module": "google-sheets:watchRows",
      "version": 2,
      "parameters": {
        "mode": "select",
        "spreadsheetId": "PICK_YOUR_DONATIONS_SHEET",
        "sheetId": "Form_Responses",
        "tableFirstRow": "A1:Z1",
        "includesHeaders": true,
        "limit": 20,
        "from": "drive"
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "id": 2,
      "module": "util:SetVariables",
      "version": 1,
      "parameters": {},
      "mapper": {
        "scope": "roundtrip",
        "variables": [
          {
            "name": "receipt",
            "value": "CHF-{{formatDate(1.`0`; \"YYYY\")}}-{{substring(\"000000\" + 1.`__ROW_NUMBER__`; length(\"000000\" + 1.`__ROW_NUMBER__`) - 6; length(\"000000\" + 1.`__ROW_NUMBER__`))}}"
          },
          {
            "name": "fund",
            "value": "{{lower(trim(1.`5`))}}"
          },
          {
            "name": "fundKnown",
            "value": "{{switch(lower(trim(1.`5`)); \"zakat\"; \"yes\"; \"sadaqah\"; \"yes\"; \"waqf\"; \"yes\"; \"general\"; \"yes\"; \"no\")}}"
          },
          {
            "name": "amount",
            "value": "{{parseNumber(1.`3`; \".\")}}"
          },
          {
            "name": "currency",
            "value": "{{upper(trim(1.`4`))}}"
          },
          {
            "name": "largeGift",
            "value": "{{if(parseNumber(1.`3`; \".\") >= 1000; \"yes\"; \"no\")}}"
          },
          {
            "name": "firstName",
            "value": "{{first(split(trim(1.`1`); \" \"))}}"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      }
    },
    {
      "id": 3,
      "module": "builtin:BasicRouter",
      "version": 1,
      "mapper": null,
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 10,
              "module": "google-sheets:addRow",
              "version": 2,
              "parameters": {},
              "filter": {
                "name": "Valid gift (amount above zero)",
                "conditions": [
                  [
                    {
                      "a": "{{2.amount}}",
                      "b": "0",
                      "o": "number:greater"
                    }
                  ]
                ]
              },
              "mapper": {
                "from": "drive",
                "mode": "select",
                "spreadsheetId": "PICK_YOUR_LEDGER_SHEET",
                "sheetId": "Ledger",
                "includesHeaders": true,
                "useColumnHeaders": true,
                "insertDataOption": "INSERT_ROWS",
                "valueInputOption": "USER_ENTERED",
                "insertUnformatted": false,
                "values": {
                  "Receipt no": "{{2.receipt}}",
                  "Date received": "{{formatDate(1.`0`; \"YYYY-MM-DD\")}}",
                  "Donor name": "{{1.`1`}}",
                  "Email": "{{lower(trim(1.`2`))}}",
                  "Amount": "{{2.amount}}",
                  "Currency": "{{2.currency}}",
                  "Fund": "{{if(2.fundKnown = \"yes\"; capitalize(2.fund); \"Unrecognised: \" + 1.`5`)}}",
                  "Thank-you sent": "{{if(2.fundKnown = \"yes\" & contains(1.`2`; \"@\"); \"Yes\"; \"No, held for trustee\")}}",
                  "Trustee flag": "{{if(2.largeGift = \"yes\"; \"Large gift, trustee to review\"; if(2.fundKnown = \"no\"; \"Fund not recognised, trustee to confirm\"; if(contains(1.`2`; \"@\"); \"\"; \"No email, trustee to thank by phone or post\")))}}",
                  "Donor message": "{{1.`7`}}"
                }
              },
              "metadata": {
                "designer": {
                  "x": 900,
                  "y": -600
                }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 20,
              "module": "google-email:sendAnEmail",
              "version": 4,
              "parameters": {},
              "filter": {
                "name": "Zakat gift with an email",
                "conditions": [
                  [
                    {
                      "a": "{{2.fund}}",
                      "b": "zakat",
                      "o": "text:equal"
                    },
                    {
                      "a": "{{1.`2`}}",
                      "b": "@",
                      "o": "text:contain"
                    }
                  ]
                ]
              },
              "mapper": {
                "to": [
                  "{{lower(trim(1.`2`))}}"
                ],
                "subject": "Your Zakat has been received: receipt {{2.receipt}}",
                "content": "<div style=\"background:#faf7f0;padding:24px 0;font-family:Helvetica,Arial,sans-serif\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td align=\"center\"><table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;background:#ffffff;border:1px solid #e3dccb;border-radius:10px;overflow:hidden\"><tr><td style=\"background:#0f4c5c;padding:20px 28px;text-align:left\"><div style=\"font-family:Georgia,serif;font-size:20px;font-weight:700;letter-spacing:1.5px;color:#ffffff\">CRESCENT HOPE FOUNDATION</div><div style=\"width:48px;height:2px;background:#b8862e;margin:8px 0\"></div><div style=\"font-family:Georgia,serif;font-size:12px;letter-spacing:1px;color:#e9dfc6\">Giving with care, reporting with honesty</div></td></tr><tr><td style=\"padding:28px\"><h1 style=\"margin:0 0 14px;font-family:Georgia,serif;font-size:23px;color:#0f4c5c\">Thank you for your Zakat</h1><p style=\"margin:0 0 14px;font-size:15px;color:#1d2a2c;line-height:1.6\">As-salamu alaykum {{2.firstName}},</p><p style=\"margin:0 0 14px;font-size:15px;color:#1d2a2c;line-height:1.6\">Thank you for trusting us with your Zakat. We have received it safely.</p><p style=\"margin:0 0 14px;font-size:15px;color:#1d2a2c;line-height:1.6\">May Allah accept it from you and reward you.</p><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;margin:18px 0;border:1px solid #e3dccb;border-radius:6px\"><tr><td style=\"padding:10px 15px;font-size:13px;color:#5f6b6a;border-bottom:1px solid #e3dccb;width:38%\">Receipt number</td><td style=\"padding:10px 15px;font-size:14px;color:#1d2a2c;border-bottom:1px solid #e3dccb;font-weight:600\">{{2.receipt}}</td></tr><tr><td style=\"padding:10px 15px;font-size:13px;color:#5f6b6a;border-bottom:1px solid #e3dccb;width:38%\">Date received</td><td style=\"padding:10px 15px;font-size:14px;color:#1d2a2c;border-bottom:1px solid #e3dccb;font-weight:600\">{{formatDate(1.`0`; \"D MMMM YYYY\")}}</td></tr><tr><td style=\"padding:10px 15px;font-size:13px;color:#5f6b6a;border-bottom:1px solid #e3dccb;width:38%\">Amount</td><td style=\"padding:10px 15px;font-size:14px;color:#1d2a2c;border-bottom:1px solid #e3dccb;font-weight:600\">{{2.currency}} {{formatNumber(2.amount; 2; \".\"; \",\")}}</td></tr><tr><td style=\"padding:10px 15px;font-size:13px;color:#5f6b6a;border-bottom:1px solid #e3dccb;width:38%\">Fund</td><td style=\"padding:10px 15px;font-size:14px;color:#1d2a2c;border-bottom:1px solid #e3dccb;font-weight:600\">Zakat</td></tr><tr><td style=\"padding:10px 15px;font-size:13px;color:#5f6b6a;border-bottom:1px solid #e3dccb;width:38%\">Donor</td><td style=\"padding:10px 15px;font-size:14px;color:#1d2a2c;border-bottom:1px solid #e3dccb;font-weight:600\">{{1.`1`}}</td></tr></table><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:0 0 16px;border-left:3px solid #b8862e;background:#faf7f0\"><tr><td style=\"padding:12px 16px\"><div style=\"font:700 12px Arial;letter-spacing:1.5px;text-transform:uppercase;color:#b8862e;margin-bottom:6px\">How your Zakat is handled</div><div style=\"font-size:14px;color:#1d2a2c;line-height:1.6\">We keep all Zakat in a separate account, apart from our other funds. Your Zakat will be given only to people who are eligible to receive it, within the eight categories (asnaf) named in the Qur'an (Surah At-Tawbah, 9:60). We do not use Zakat to pay our running costs.</div></td></tr></table><p style=\"margin:0 0 14px;font-size:15px;color:#1d2a2c;line-height:1.6\">Please keep this email for your records. If any detail is wrong, reply to this email and we will correct it.</p><p style=\"margin:0 0 14px;font-size:15px;color:#1d2a2c;line-height:1.6\">With thanks,<br>The Crescent Hope Foundation team</p></td></tr><tr><td style=\"background:#faf7f0;padding:16px 28px;font-size:12px;color:#5f6b6a;border-top:1px solid #e3dccb;line-height:1.6\">This email is an acknowledgement of your gift. It is not a tax receipt.<br>Crescent Hope Foundation (a fictional organisation) &middot; hello@example.org</td></tr></table></td></tr></table></div>",
                "bodyType": "rawHtml"
              },
              "metadata": {
                "designer": {
                  "x": 900,
                  "y": -300
                }
              },
              "onerror": [
                {
                  "id": 200,
                  "module": "http:MakeRequest",
                  "version": 4,
                  "parameters": {
                    "tlsType": "",
                    "authenticationType": "noAuth"
                  },
                  "mapper": {
                    "url": "https://hook.eu1.make.com/YOUR_ERROR_WATCHER_WEBHOOK",
                    "method": "post",
                    "timeout": "40",
                    "contentType": "urlEncoded",
                    "shareCookies": false,
                    "parseResponse": true,
                    "allowRedirects": true,
                    "stopOnHttpError": true,
                    "urlEncodedBodyContent": [
                      {
                        "name": "scenario",
                        "value": "Donation thank-you and receipt"
                      },
                      {
                        "name": "step",
                        "value": "Zakat thank-you email"
                      },
                      {
                        "name": "error",
                        "value": "{{20.error.message}}"
                      },
                      {
                        "name": "data",
                        "value": "{{2.receipt}}"
                      }
                    ],
                    "requestCompressedContent": true
                  },
                  "metadata": {
                    "designer": {
                      "x": 1200,
                      "y": -100
                    }
                  }
                },
                {
                  "id": 201,
                  "module": "builtin:Break",
                  "version": 1,
                  "parameters": {
                    "count": 3,
                    "interval": 15,
                    "retry": true
                  },
                  "mapper": {},
                  "metadata": {
                    "designer": {
                      "x": 1500,
                      "y": -100
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "flow": [
            {
              "id": 30,
              "module": "google-email:sendAnEmail",
