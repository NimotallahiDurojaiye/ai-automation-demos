{
  "name": "07b Weekly donations summary",
  "flow": [
    {
      "id": 1,
      "module": "google-sheets:filterRows",
      "version": 2,
      "parameters": {},
      "mapper": {
        "from": "drive",
        "limit": "10",
        "filter": [
          [
            {
              "a": "A",
              "o": "exist"
            }
          ]
        ],
        "sheetId": "Weekly_Summary",
        "sortOrder": "asc",
        "spreadsheetId": "PICK_YOUR_LEDGER_SHEET",
        "tableFirstRow": "A1:F1",
        "includesHeaders": true,
        "valueRenderOption": "FORMATTED_VALUE",
        "dateTimeRenderOption": "FORMATTED_STRING"
      },
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "id": 2,
      "module": "util:TextAggregator",
      "version": 1,
      "parameters": {
        "feeder": 1,
        "rowSeparator": ""
      },
      "mapper": {
        "value": "<tr><td style=\"padding:10px 14px;border-bottom:1px solid #e3dccb;font-weight:600;color:#0f4c5c\">{{1.`0`}}</td><td style=\"padding:10px 14px;border-bottom:1px solid #e3dccb;text-align:right\">{{1.`1`}}</td><td style=\"padding:10px 14px;border-bottom:1px solid #e3dccb;text-align:right\">{{1.`2`}}</td><td style=\"padding:10px 14px;border-bottom:1px solid #e3dccb;text-align:right\">{{1.`3`}}</td><td style=\"padding:10px 14px;border-bottom:1px solid #e3dccb;text-align:right\">{{1.`4`}}</td></tr>"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      }
    },
    {
      "id": 3,
      "module": "google-email:sendAnEmail",
      "version": 4,
      "parameters": {},
      "mapper": {
        "to": [
          "treasurer@example.org",
          "trustee@example.org"
        ],
        "subject": "Weekly donations summary, week ending {{formatDate(now; \"D MMMM YYYY\")}}",
        "content": "<div style=\"background:#faf7f0;padding:24px 0;font-family:Helvetica,Arial,sans-serif\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td align=\"center\"><table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;background:#ffffff;border:1px solid #e3dccb;border-radius:10px;overflow:hidden\"><tr><td style=\"background:#0f4c5c;padding:20px 28px;text-align:left\"><div style=\"font-family:Georgia,serif;font-size:20px;font-weight:700;letter-spacing:1.5px;color:#ffffff\">CRESCENT HOPE FOUNDATION</div><div style=\"width:48px;height:2px;background:#b8862e;margin:8px 0\"></div><div style=\"font-family:Georgia,serif;font-size:12px;letter-spacing:1px;color:#e9dfc6\">Giving with care, reporting with honesty</div></td></tr><tr><td style=\"padding:28px\"><h1 style=\"margin:0 0 14px;font-family:Georgia,serif;font-size:23px;color:#0f4c5c\">Weekly donations summary</h1><p style=\"margin:0 0 14px;font-size:15px;color:#1d2a2c;line-height:1.6\">As-salamu alaykum. Here are the gifts logged in the last 7 days, one line per fund. The figures come from formulas in the ledger, not from this email.</p><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;margin:18px 0;border:1px solid #e3dccb;font-size:14px;color:#1d2a2c\"><tr><th style=\"padding:10px 14px;background:#faf7f0;font-size:12px;color:#5f6b6a;text-align:left;border-bottom:1px solid #e3dccb\">Fund</th><th style=\"padding:10px 14px;background:#faf7f0;font-size:12px;color:#5f6b6a;text-align:right;border-bottom:1px solid #e3dccb\">Gifts</th><th style=\"padding:10px 14px;background:#faf7f0;font-size:12px;color:#5f6b6a;text-align:right;border-bottom:1px solid #e3dccb\">Total GBP</th><th style=\"padding:10px 14px;background:#faf7f0;font-size:12px;color:#5f6b6a;text-align:right;border-bottom:1px solid #e3dccb\">Gifts in other currencies</th><th style=\"padding:10px 14px;background:#faf7f0;font-size:12px;color:#5f6b6a;text-align:right;border-bottom:1px solid #e3dccb\">Flagged</th></tr>{{2.text}}</table><p style=\"margin:0 0 14px;font-size:15px;color:#1d2a2c;line-height:1.6\">Funds are reported separately on purpose. Zakat is never added to other funds in a single total.</p><p style=\"margin:0 0 14px;font-size:15px;color:#1d2a2c;line-height:1.6\">Flagged gifts are listed in the ledger with the reason. Please check that each one has been followed up.</p><p style=\"margin:0 0 14px;font-size:15px;color:#1d2a2c;line-height:1.6\"><a href=\"https://docs.google.com/spreadsheets/d/PICK_YOUR_LEDGER_SHEET\" style=\"color:#0f4c5c;font-weight:700\">Open the ledger</a></p></td></tr><tr><td style=\"background:#faf7f0;padding:16px 28px;font-size:12px;color:#5f6b6a;border-top:1px solid #e3dccb;line-height:1.6\">This email is an acknowledgement of your gift. It is not a tax receipt.<br>Crescent Hope Foundation (a fictional organisation) &middot; hello@example.org</td></tr></table></td></tr></table></div>",
        "bodyType": "rawHtml"
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      },
      "onerror": [
        {
          "id": 30,
          "module": "http:MakeRequest",
          "version": 4,
          "parameters": {
            "tlsType": "",
            "authenticationType": "noAuth"
          },
          "mapper": {
            "url": "https://hook.eu1.make.com/YOUR_ERROR_WATCHER_WEBHOOK",
            "method": "post",
            "timeout": "40",
            "contentType": "urlEncoded",
            "shareCookies": false,
            "parseResponse": true,
            "allowRedirects": true,
            "stopOnHttpError": true,
            "urlEncodedBodyContent": [
              {
                "name": "scenario",
                "value": "07b Weekly donations summary"
              },
              {
                "name": "step",
                "value": "Summary email"
              },
              {
                "name": "error",
                "value": "{{3.error.message}}"
              }
            ],
            "requestCompressedContent": true
          },
          "metadata": {
            "designer": {
              "x": 900,
              "y": 200
            }
          }
        },
        {
          "id": 31,
          "module": "builtin:Break",
          "version": 1,
          "parameters": {
            "count": 3,
            "interval": 15,
            "retry": true
          },
          "mapper": {},
          "metadata": {
            "designer": {
              "x": 1200,
              "y": 200
            }
          }
        }
      ]
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": true,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    }
  }
}