{
  "name": "05 Shariah screening alert (monthly)",
  "flow": [
    {
      "id": 1,
      "module": "google-sheets:filterRows",
      "version": 2,
      "parameters": {},
      "mapper": {
        "from": "drive",
        "mode": "select",
        "spreadsheetId": "PICK_YOUR_SHEET",
        "sheetId": "Watchlist",
        "tableFirstRow": "A1:X1",
        "includesHeaders": true,
        "valueRenderOption": "FORMATTED_VALUE",
        "dateTimeRenderOption": "FORMATTED_STRING",
        "sortOrder": "asc",
        "limit": "500"
      },
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "id": 2,
      "module": "util:TextAggregator",
      "version": 1,
      "parameters": {
        "feeder": 1,
        "rowSeparator": ""
      },
      "mapper": {
        "value": "<tr><td style=\"padding:6px 8px;border-bottom:1px solid #d9d4d5\"><b>{{1.`0`}}</b></td><td style=\"padding:6px 8px;border-bottom:1px solid #d9d4d5\">{{1.`1`}}</td><td style=\"padding:6px 8px;border-bottom:1px solid #d9d4d5\">{{1.`14`}}</td><td style=\"padding:6px 8px;border-bottom:1px solid #d9d4d5\">{{1.`15`}}</td><td style=\"padding:6px 8px;border-bottom:1px solid #d9d4d5\">{{1.`16`}}</td><td style=\"padding:6px 8px;border-bottom:1px solid #d9d4d5\">{{1.`17`}}</td><td style=\"padding:6px 8px;border-bottom:1px solid #d9d4d5\"><b>{{1.`21`}}</b></td><td style=\"padding:6px 8px;border-bottom:1px solid #d9d4d5\">{{1.`13`}}</td><td style=\"padding:6px 8px;border-bottom:1px solid #d9d4d5\">{{1.`22`}}</td><td style=\"padding:6px 8px;border-bottom:1px solid #d9d4d5\">{{1.`23`}}</td></tr>"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      }
    },
    {
      "id": 3,
      "module": "google-sheets:filterRows",
      "version": 2,
      "parameters": {},
      "mapper": {
        "from": "drive",
        "mode": "select",
        "spreadsheetId": "PICK_YOUR_SHEET",
        "sheetId": "Watchlist",
        "tableFirstRow": "A1:X1",
        "includesHeaders": true,
        "valueRenderOption": "FORMATTED_VALUE",
        "dateTimeRenderOption": "FORMATTED_STRING",
        "sortOrder": "asc",
        "limit": "500",
        "filter": [
          [
            {
              "a": "W",
              "b": "YES",
              "o": "text:equal:ci"
            }
          ]
        ]
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      }
    },
    {
      "id": 4,
      "module": "util:TextAggregator",
      "version": 1,
      "parameters": {
        "feeder": 3,
        "rowSeparator": "other",
        "otherRowSeparator": " || "
      },
      "mapper": {
        "value": "ticker={{3.`0`}}, company={{3.`1`}}, status last month={{3.`13`}}, status now={{3.`21`}}, debt ratio now={{3.`14`}} (last month {{3.`10`}}), deposits ratio now={{3.`15`}} (last month {{3.`11`}}), income ratio now={{3.`16`}} (last month {{3.`12`}}), business activity screen={{3.`17`}}"
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        }
      }
    },
    {
      "id": 5,
      "module": "http:MakeRequest",
      "version": 4,
      "parameters": {
        "tlsType": "",
        "authenticationType": "noAuth"
      },
      "mapper": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "post",
        "headers": [
          {
            "name": "x-api-key",
            "value": "YOUR_ANTHROPIC_API_KEY"
          },
          {
            "name": "anthropic-version",
            "value": "2023-06-01"
          },
          {
            "name": "anthropic-beta",
            "value": "server-side-fallback-2026-07-01"
          },
          {
            "name": "content-type",
            "value": "application/json"
          }
        ],
        "contentType": "json",
        "inputMethod": "jsonString",
        "jsonStringBodyContent": "{\n \"model\": \"claude-opus-5-5\",\n \"max_tokens\": 2048,\n \"fallbacks\": \"default\",\n \"output_config\": {\n  \"effort\": \"low\",\n  \"format\": {\n   \"type\": \"json_schema\",\n   \"schema\": {\n    \"type\": \"object\",\n    \"properties\": {\n     \"explanations\": {\n      \"type\": \"array\",\n      \"items\": {\n       \"type\": \"object\",\n       \"properties\": {\n        \"ticker\": {\n         \"type\": \"string\"\n        },\n        \"screens_that_changed\": {\n         \"type\": \"array\",\n         \"items\": {\n          \"type\": \"string\",\n          \"enum\": [\n           \"debt\",\n           \"deposits\",\n           \"income\",\n           \"business_activity\"\n          ]\n         }\n        },\n        \"explanation\": {\n         \"type\": \"string\"\n        },\n        \"needs_human_check\": {\n         \"type\": \"boolean\"\n        }\n       },\n       \"required\": [\n        \"ticker\",\n        \"screens_that_changed\",\n        \"explanation\",\n        \"needs_human_check\"\n       ],\n       \"additionalProperties\": false\n      }\n     }\n    },\n    \"required\": [\n     \"explanations\"\n    ],\n    \"additionalProperties\": false\n   }\n  }\n },\n \"messages\": [\n  {\n   \"role\": \"user\",\n   \"content\": \"You are helping the admin of a small family investment club write a monthly Shariah screening note. The shares below changed screening status since last month. Every ratio, limit and status was computed by a spreadsheet formula before you saw it.\\n\\nScreens and limits (AAOIFI Shari'ah Standard No. 21, clause 3/4): interest-bearing debt up to 30% of market capitalisation; interest-bearing deposits up to 30% of market capitalisation; non-permissible income up to 5% of total revenue; business activity must be permissible.\\n\\nFor each share, write two or three short, plain-English sentences saying which screen or screens caused the change. Quote this month's ratio, last month's ratio and the limit exactly as given.\\n\\nRules:\\n1. Use only the numbers given. Do not recalculate, re-round, estimate or add any number.\\n2. Do not change or contradict any status. If the data looks inconsistent, write 'figures need checking' and set needs_human_check to true.\\n3. Do not say why the company's figures moved (for example, new borrowing) unless the data says so. If the cause is not in the data, say the figures alone do not show why.\\n4. Do not give a Shariah ruling, a fatwa, or a buy, sell or hold recommendation.\\n5. Plain British English. No em dashes.\\n\\nShares: {{4.text}}\"\n  }\n ]\n}",
        "timeout": "120",
        "shareCookies": false,
        "parseResponse": true,
        "allowRedirects": true,
        "stopOnHttpError": true,
        "requestCompressedContent": true
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0
        }
      },
      "onerror": [
        {
          "id": 90,
          "module": "builtin:Break",
          "version": 1,
          "parameters": {
            "count": 3,
            "interval": 15,
            "retry": true
          },
          "mapper": {},
          "metadata": {
            "designer": {
              "x": 1200,
              "y": 300
            }
          }
        }
      ]
    },
    {
      "id": 6,
      "module": "builtin:BasicRouter",
      "version": 1,
      "mapper": null,
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 0
        }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 7,
              "module": "json:ParseJSON",
              "version": 1,
              "parameters": {
                "type": ""
              },
              "mapper": {
                "json": "{{first(map(5.data.content; \"text\"; \"type\"; \"text\"))}}"
              },
              "metadata": {
                "designer": {
                  "x": 1800,
                  "y": -150
                }
              },
              "filter": {
                "name": "Claude finished normally",
                "conditions": [
                  [
                    {
                      "a": "{{5.data.stop_reason}}",
                      "b": "end_turn",
                      "o": "text:equal"
                    }
                  ]
                ]
              }
            },
            {
              "id": 8,
              "module": "builtin:BasicFeeder",
              "version": 1,
              "parameters": {},
              "mapper": {
                "array": "{{7.explanations}}"
              },
              "metadata": {
                "designer": {
                  "x": 2100,
                  "y": -150
                }
              }
            },
            {
              "id": 9,
              "module": "util:TextAggregator",
              "version": 1,
              "parameters": {
                "feeder": 8,
                "rowSeparator": ""
              },
              "mapper": {
                "value": "<p style=\"margin:0 0 10px\"><b>{{8.ticker}}</b>: {{8.explanation}}{{if(8.needs_human_check; \" <b style=\\\"color:#b3202a\\\">[check figures]</b>\"; \"\")}}</p>"
              },
              "metadata": {
                "designer": {
                  "x": 2400,
                  "y": -150
                }
              }
            },
            {
              "id": 10,
              "module": "google-email:sendAnEmail",
              "version": 4,
              "parameters": {},
              "mapper": {
                "to": [
                  "admin@example.org"
                ],
                "subject": "Monthly Shariah screen: status changes for review ({{formatDate(now; \"MMMM YYYY\")}})",
                "bodyType": "rawHtml",
                "content": "<div style=\"font-family:Segoe UI,Helvetica,Arial,sans-serif;color:#1d1416;max-width:760px\"><h2 style=\"color:#4a1424;margin:0 0 6px\">Monthly Shariah screen</h2><p style=\"margin:0 0 16px;color:#5f5456\">For the club admin to review before sharing with members.</p><h3 style=\"color:#4a1424;margin:0 0 8px\">What changed</h3>{{9.text}}<h3 style=\"color:#4a1424;margin:18px 0 8px\">Full watchlist</h3><table cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;font-size:13px;width:100%\"><tr><th style=\"text-align:left;padding:6px 8px;background:#4a1424;color:#ffffff\">Ticker</th><th style=\"text-align:left;padding:6px 8px;background:#4a1424;color:#ffffff\">Company</th><th style=\"text-align:left;padding:6px 8px;background:#4a1424;color:#ffffff\">Debt / mcap</th><th style=\"text-align:left;padding:6px 8px;background:#4a1424;color:#ffffff\">Deposits / mcap</th><th style=\"text-align:left;padding:6px 8px;background:#4a1424;color:#ffffff\">Non-perm. income / revenue</th><th style=\"text-align:left;padding:6px 8px;background:#4a1424;color:#ffffff\">Business</th><th style=\"text-align:left;padding:6px 8px;background:#4a1424;color:#ffffff\">Status</th><th style=\"text-align:left;padding:6px 8px;background:#4a1424;color:#ffffff\">Last month</th><th style=\"text-align:left;padding:6px 8px;background:#4a1424;color:#ffffff\">Changed</th><th style=\"text-align:left;padding:6px 8px;background:#4a1424;color:#ffffff\">Purification per share (MYR)</th></tr>{{2.text}}</table><p style=\"font-size:12px;color:#5f5456;margin-top:18px\">Ratios and statuses are computed by spreadsheet formulas that mirror screen.py. The explanations were drafted by AI from those numbers only. Limits follow AAOIFI Shari'ah Standard No. 21, clause 3/4. This report is for education and club discussion. It is not a fatwa or investment advice. Please confirm any change with the club's Shariah adviser before sharing with members.</p></div>"
              },
              "metadata": {
                "designer": {
                  "x": 2700,
                  "y": -150
                }
              },
              "onerror": [
                {
                  "id": 91,
                  "module": "builtin:Break",
                  "version": 1,
                  "parameters": {
                    "count": 3,
                    "interval": 15,
                    "retry": true
                  },
                  "mapper": {},
                  "metadata": {
                    "designer": {
                      "x": 2700,
                      "y": 150
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "flow": [
            {
              "id": 11,
              "module": "google-email:sendAnEmail",
              "version": 4,
              "parameters": {},
              "mapper": {
                "to": [
                  "admin@example.org"
                ],
                "subject": "Monthly Shariah screen: explanations need writing by hand",
                "bodyType": "rawHtml",
                "content": "<div style=\"font-family:Segoe UI,Helvetica,Arial,sans-serif;color:#1d1416;max-width:760px\"><h2 style=\"color:#4a1424\">Monthly Shariah screen</h2><p style=\"background:#ffffff;border-left:4px solid #b3202a;padding:10px\">The AI step did not finish normally (stop reason: {{5.data.stop_reason}}), so no explanations were drafted. The numbers below are unaffected because they come from the sheet. Please write the notes by hand.</p><table cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;font-size:13px;width:100%\"><tr><th style=\"text-align:left;padding:6px 8px;background:#4a1424;color:#ffffff\">Ticker</th><th style=\"text-align:left;padding:6px 8px;background:#4a1424;color:#ffffff\">Company</th><th style=\"text-align:left;padding:6px 8px;background:#4a1424;color:#ffffff\">Debt / mcap</th><th style=\"text-align:left;padding:6px 8px;background:#4a1424;color:#ffffff\">Deposits / mcap</th><th style=\"text-align:left;padding:6px 8px;background:#4a1424;color:#ffffff\">Non-perm. income / revenue</th><th style=\"text-align:left;padding:6px 8px;background:#4a1424;color:#ffffff\">Business</th><th style=\"text-align:left;padding:6px 8px;background:#4a1424;color:#ffffff\">Status</th><th style=\"text-align:left;padding:6px 8px;background:#4a1424;color:#ffffff\">Last month</th><th style=\"text-align:left;padding:6px 8px;background:#4a1424;color:#ffffff\">Changed</th><th style=\"text-align:left;padding:6px 8px;background:#4a1424;color:#ffffff\">Purification per share (MYR)</th></tr>{{2.text}}</table><p style=\"font-size:12px;color:#5f5456;margin-top:18px\">Ratios and statuses are computed by spreadsheet formulas that mirror screen.py. The explanations were drafted by AI from those numbers only. Limits follow AAOIFI Shari'ah Standard No. 21, clause 3/4. This report is for education and club discussion. It is not a fatwa or investment advice. Please confirm any change with the club's Shariah adviser before sharing with members.</p></div>"
              },
              "metadata": {
                "designer": {
                  "x": 1800,
                  "y": 150
                }
              },
              "filter": {
                "name": "Refusal or any other stop reason",
                "conditions": [
                  [
                    {
                      "a": "{{5.data.stop_reason}}",
                      "b": "end_turn",
                      "o": "text:notequal"
                    }
                  ]
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": true,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    }
  }
}