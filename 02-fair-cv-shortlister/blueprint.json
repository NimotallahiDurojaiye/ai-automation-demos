                        "mode": "select",
                        "values": {
                          "Candidate ID": "HL-{{1.`__ROW_NUMBER__` + 1000}}",
                          "Received": "{{1.`Timestamp`}}",
                          "Total (out of 15)": "{{11.c1.score + 11.c2.score + 11.c3.score + 11.c4.score + 11.c5.score}}",
                          "C1 Operations": "{{11.c1.score}}",
                          "C1 evidence": "{{11.c1.evidence}}",
                          "C2 Data": "{{11.c2.score}}",
                          "C2 evidence": "{{11.c2.evidence}}",
                          "C3 Communication": "{{11.c3.score}}",
                          "C3 evidence": "{{11.c3.evidence}}",
                          "C4 Problem solving": "{{11.c4.score}}",
