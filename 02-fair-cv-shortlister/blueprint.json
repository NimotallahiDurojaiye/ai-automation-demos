                    "value": "application/json"
                  }
                ],
                "timeout": "120",
                "contentType": "json",
                "inputMethod": "jsonString",
                "jsonStringBodyContent": "{\"model\": \"claude-opus-5-5\", \"max_tokens\": 2048, \"fallbacks\": \"default\", \"output_config\": {\"effort\": \"low\", \"format\": {\"type\": \"json_schema\", \"schema\": {\"type\": \"object\", \"properties\": {\"candidate_id\": {\"type\": \"string\"}, \"c1\": {\"type\": \"object\", \"properties\": {\"score\": {\"type\": \"integer\", \"enum\": [0, 1, 2, 3]}, \"evidence\": {\"type\": \"string\"}}, \"required\": [\"score\", \"evidence\"], \"additionalProperties\": false}, \"c2\": {\"type\": \"object\", \"properties\": {\"score\": {\"type\": \"integer\", \"enum\": [0, 1, 2, 3]}, \"evidence\": {\"type\": \"string\"}}, \"required\": [\"score\", \"evidence\"], \"additionalProperties\": false}, \"c3\": {\"type\": \"object\", \"properties\": {\"score\": {\"type\": \"integer\", \"enum\": [0, 1, 2, 3]}, \"evidence\": {\"type\": \"string\"}}, \"required\": [\"score\", \"evidence\"], \"additionalProperties\": false}, \"c4\": {\"type\": \"object\", \"properties\": {\"score\": {\"type\": \"integer\", \"enum\": [0, 1, 2, 3]}, \"evidence\": {\"type\": \"string\"}}, \"required\": [\"score\", \"evidence\"], \"additionalProperties\": false}, \"c5\": {\"type\": \"object\", \"properties\": {\"score\": {\"type\": \"integer\", \"enum\": [0, 1, 2, 3]}, \"evidence\": {\"type\": \"string\"}}, \"required\": [\"score\", \"evidence\"], \"additionalProperties\": false}, \"gaps_for_human\": {\"type\": \"string\"}, \"summary\": {\"type\": \"string\"}}, \"required\": [\"candidate_id\", \"c1\", \"c2\", \"c3\", \"c4\", \"c5\", \"gaps_for_human\", \"summary\"], \"additionalProperties\": false}}}, \"messages\": [{\"role\": \"user\", \"content\": {{8.json}}}]}",
                "shareCookies": false,
                "parseResponse": true,
                "allowRedirects": true,
                "stopOnHttpError": true,
                "requestCompressedContent": true
              },
