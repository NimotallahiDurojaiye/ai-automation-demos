{
  "name": "03B Send approved meeting summary",
  "flow": [
    {
      "id": 1,
      "module": "google-sheets:filterRows",
      "version": 2,
      "parameters": {},
      "mapper": {
        "from": "drive",
        "limit": "10",
        "filter": [
          [
            {
              "a": "I",
              "b": "TRUE",
              "o": "text:equal:ci"
            },
            {
              "a": "J",
              "o": "notexist"
            }
          ]
        ],
        "sheetId": "Approvals",
        "sortOrder": "asc",
        "spreadsheetId": "PICK_YOUR_SHEET",
        "tableFirstRow": "A1:J1",
        "includesHeaders": true,
        "valueRenderOption": "FORMATTED_VALUE",
        "dateTimeRenderOption": "FORMATTED_STRING"
      },
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "id": 2,
      "module": "google-email:sendAnEmail",
      "version": 4,
      "parameters": {},
      "mapper": {
        "to": [
          "{{1.`3`}}"
        ],
        "subject": "Meeting summary: {{1.`1`}} ({{1.`0`}})",
        "content": "<div style=\"font-family:Helvetica,Arial,sans-serif;color:#1d1416;max-width:640px;line-height:1.55;font-size:14px\"><p>Summary of <b>{{1.`1`}}</b> on {{1.`0`}}, checked by the meeting lead.</p><h3 style=\"color:#4a1424;margin:18px 0 6px;font-size:15px\">Summary</h3><p>{{replace(1.`4`; newline; \"<br>\")}}</p><h3 style=\"color:#4a1424;margin:18px 0 6px;font-size:15px\">Decisions</h3><p>{{replace(1.`5`; newline; \"<br>\")}}</p><h3 style=\"color:#4a1424;margin:18px 0 6px;font-size:15px\">Action items</h3><p>{{replace(1.`6`; newline; \"<br>\")}}</p><h3 style=\"color:#4a1424;margin:18px 0 6px;font-size:15px\">Open questions</h3><p>{{replace(1.`7`; newline; \"<br>\")}}</p><p style=\"color:#5f5456;font-size:12px\">Full action list: <a href=\"https://docs.google.com/spreadsheets/d/PICK_YOUR_SHEET\">team tracker</a>.</p></div>",
        "bodyType": "rawHtml"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      },
      "filter": {
        "name": "Has team address",
        "conditions": [
          [
            {
              "a": "{{1.`3`}}",
              "o": "text:contain",
              "b": "@"
            }
          ]
        ]
      },
      "onerror": [
        {
          "id": 90,
          "module": "http:MakeRequest",
          "version": 4,
          "parameters": {
            "tlsType": "",
            "authenticationType": "noAuth"
          },
          "mapper": {
            "url": "https://hook.eu1.make.com/YOUR_ERROR_WATCHER_WEBHOOK",
            "method": "post",
            "timeout": "40",
            "contentType": "urlEncoded",
            "shareCookies": false,
            "parseResponse": true,
            "allowRedirects": true,
            "stopOnHttpError": true,
            "urlEncodedBodyContent": [
              {
                "name": "scenario",
                "value": "03B Send approved meeting summary"
              },
              {
                "name": "step",
                "value": "Team email"
              },
              {
                "name": "error",
                "value": "{{2.error.message}}"
              },
              {
                "name": "data",
                "value": "{{1.`1`}}"
              }
            ],
            "requestCompressedContent": true
          },
          "metadata": {
            "designer": {
              "x": 300,
              "y": 300
            }
          }
        },
        {
          "id": 91,
          "module": "builtin:Break",
          "version": 1,
          "parameters": {
            "count": 3,
            "interval": 15,
            "retry": true
          },
          "mapper": {},
          "metadata": {
            "designer": {
              "x": 600,
              "y": 300
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "module": "google-sheets:updateRow",
      "version": 2,
      "parameters": {},
      "mapper": {
        "from": "drive",
        "mode": "select",
        "sheetId": "Approvals",
        "spreadsheetId": "PICK_YOUR_SHEET",
        "includesHeaders": true,
        "rowNumber": "{{1.`__ROW_NUMBER__`}}",
        "values": {
          "9": "{{formatDate(now; \"YYYY-MM-DD HH:mm\")}}"
        },
        "valueInputOption": "USER_ENTERED"
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": true,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    }
  }
}